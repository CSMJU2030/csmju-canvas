# CS Canvas (csmju-canvas) — Backend
# คัดลอกเป็น .env แล้วเติมค่าจริง · ห้าม commit .env

# ฐานข้อมูลของระบบนี้เท่านั้น (pnpm --filter backend db:up)
DATABASE_URL=postgresql://postgres@127.0.0.1:55207/csmju_canvas

PORT=4207
NODE_ENV=development
TZ=Asia/Bangkok

# จำนวน connection สูงสุดของระบบนี้ (server ตั้ง 5 · deployment.md ข้อ 4.1)
DATABASE_POOL_MAX=5

# โฟลเดอร์เก็บไฟล์รูปที่ผู้ใช้อัปโหลด (ไม่อยู่ใน git)
LOCAL_STORAGE_DIR=./storage-dev

# โดเมนของหน้าบ้าน คั่นด้วยลูกน้ำ · เว้นว่างในโหมด dev
CORS_ORIGIN=

# Core Hub ตัวจริงของโครงการ (connect-core-hub.md ข้อ 4)
# ค่า ISSUER / AUDIENCE เป็นส่วนหนึ่งของสัญญา ห้ามเปลี่ยนเอง
CORE_HUB_URL=https://csmju2030.jowave.com
CORE_HUB_WEB_URL=https://csmju2030.jowave.com
CORE_HUB_JWKS_URL=https://csmju2030.jowave.com/api/v1/.well-known/jwks.json
CORE_HUB_ISSUER=core-hub
CORE_HUB_AUDIENCE=csmju2030
SUBSYSTEM_ID=csmju-canvas

# การแคชกุญแจ JWKS (auth-contract.md ข้อ 4.1)
JWKS_CACHE_TTL_MS=600000
JWKS_MIN_REFRESH_INTERVAL_MS=30000
JWKS_REQUEST_TIMEOUT_MS=5000
JWT_CLOCK_TOLERANCE_SEC=5
