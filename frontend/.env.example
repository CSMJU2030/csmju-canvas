# หน้าบ้าน — คัดลอกเป็น .env.local (ห้าม commit)
# ค่าที่ขึ้นต้นด้วย NEXT_PUBLIC_ ถูกฝังลง JavaScript ที่ส่งให้เบราว์เซอร์ ห้ามใส่ความลับ

# next.config.ts rewrite /api/* และ /auth/login /auth/callback /auth/logout ไปที่นี่
BACKEND_URL=http://127.0.0.1:4207

# เว็บของ Core Hub — ใช้ทำลิงก์ไปหน้าบัญชีที่ Core Hub เท่านั้น (ไม่ใช่ทางเข้าระบบ)
NEXT_PUBLIC_CORE_HUB_WEB_URL=https://csmju2030.jowave.com
